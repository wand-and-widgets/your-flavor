<div class="yf-config-container">
    {{> "modules/your-flavor/templates/parts/flavor-preview-panel.hbs"}}

    <main class="yf-controls-panel">
        <div class="yf-controls-scroll">
            <div class="yf-tab-bar">
                {{#each tabs}}
                <button type="button" class="yf-tab {{#if this.isActive}}active{{/if}} {{#if this.isDirty}}is-dirty{{/if}}" data-action="switchTab" data-tab="{{this.id}}" aria-pressed="{{#if this.isActive}}true{{else}}false{{/if}}" title="{{this.label}}" aria-label="{{this.label}}">
                    <i class="{{this.icon}}"></i>
                    <span class="yf-tab-label">{{this.label}}</span>
                    <span class="yf-dirty-indicator" title="{{this.dirtyTitle}}" aria-label="{{this.dirtyTitle}}" {{#unless this.isDirty}}hidden{{/unless}}></span>
                </button>
                {{/each}}
            </div>

            {{#if (eq activeTab "overview")}}
            {{> "modules/your-flavor/templates/parts/flavor-overview-tab.hbs"}}
            {{else}}
            {{#if (eq activeTab "chat")}}
            {{> "modules/your-flavor/templates/parts/flavor-chat-tab.hbs"}}
            {{/if}}
            {{#if (eq activeTab "rolls")}}
            {{> "modules/your-flavor/templates/parts/flavor-rolls-tab.hbs"}}
            {{/if}}
            {{#if (eq activeTab "cards")}}
            {{> "modules/your-flavor/templates/parts/flavor-cards-tab.hbs"}}
            {{/if}}
            {{#if (eq activeTab "foundry")}}
            {{> "modules/your-flavor/templates/parts/flavor-foundry-tab.hbs"}}
            {{/if}}
            {{#if (eq activeTab "icons")}}
            {{> "modules/your-flavor/templates/parts/flavor-icons-tab.hbs"}}
            {{/if}}
            {{#if (eq activeTab "diagnostics")}}
            {{> "modules/your-flavor/templates/parts/flavor-diagnostics-tab.hbs"}}
            {{/if}}
            {{/if}}
        </div>

        {{> "modules/your-flavor/templates/parts/flavor-footer.hbs"}}
    </main>
</div>

<section class="yf-rolls-context" aria-label="{{localize 'YOUR_FLAVOR.Config.RollsDesign.ContextLabel'}}">
    <div class="yf-rolls-context-title">
        <span>{{localize "YOUR_FLAVOR.Config.RollsDesign.Workbench"}}</span>
    </div>

    <div class="yf-rolls-context-profile">
        <small>{{localize "YOUR_FLAVOR.Config.RollsDesign.Editing"}}</small>
        <strong>{{rollTabs.context.profileName}}</strong>
    </div>

    <div class="yf-rolls-context-theme" title="{{localize 'YOUR_FLAVOR.Config.RollTabs.ThemeTitle'}}">
        <small>{{localize "YOUR_FLAVOR.Config.RollsDesign.Theme"}}</small>
        <strong>{{rollTabs.context.layoutLabel}}</strong>
    </div>

    <div class="yf-rolls-context-enable">
        {{#if canCustomize}}
            {{#unless hasForcedLayout}}
            <span>{{localize "YOUR_FLAVOR.Config.RollTabs.Enabled"}}</span>
            <label class="yf-toggle-switch yf-rolls-master-toggle" title="{{rollTabs.enabledTitle}}">
                <input type="checkbox"
                       name="rolls.enabled"
                       {{#if rollTabs.enabled}}checked{{/if}}
                       aria-label="{{localize 'YOUR_FLAVOR.Config.RollTabs.Enabled'}}">
                <span class="yf-toggle-slider"></span>
            </label>
            {{else}}
            <span class="yf-rolls-context-readonly">
                {{localize "YOUR_FLAVOR.Config.ForcedLayout"}}
            </span>
            {{/unless}}
        {{else}}
        <span class="yf-rolls-context-readonly">
            {{localize "YOUR_FLAVOR.Config.RollsDesign.ReadOnlyTitle"}}
        </span>
        {{/if}}
    </div>
</section>

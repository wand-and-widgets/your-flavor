            {{#unless canCustomize}}
            <div class="yf-notice yf-notice-warning">
                <i class="fas fa-lock"></i>
                <span>{{localize "YOUR_FLAVOR.Config.NoPermission"}}</span>
            </div>
            {{else}}
            {{#if hasForcedLayout}}
            <div class="yf-notice yf-notice-info">
                <i class="fas fa-info-circle"></i>
                <span>{{localize "YOUR_FLAVOR.Config.ForcedLayout"}} <strong>{{forcedLayoutName}}</strong></span>
            </div>
            {{else}}
            <section class="yf-section">
                <div class="yf-section-header">
                    <i class="fas fa-scroll"></i>
                    <h3>{{localize "YOUR_FLAVOR.Config.CardTabs.Title"}}</h3>
                </div>

                <div class="yf-enable-row">
                    <span class="yf-enable-label">{{localize "YOUR_FLAVOR.Config.CardTabs.Enabled"}}</span>
                    <label class="yf-toggle-switch" title="{{cardTabs.enabledTitle}}">
                        <input type="checkbox" name="cards.enabled" {{#if cardTabs.enabled}}checked{{/if}}>
                        <span class="yf-toggle-slider"></span>
                    </label>
                </div>

                <div class="yf-card-surface-grid">
                    {{#each cardTabs.surfaces}}
                    <article class="yf-card-surface-card">
                        <div class="yf-card-surface-header">
                            <i class="{{this.icon}}"></i>
                            <span>{{this.label}}</span>
                        </div>
                        <div class="yf-card-field-list">
                            {{#each this.fields}}
                            <div class="yf-card-field yf-token-control yf-token-color-control {{this.statusClass}}">
                                <span class="yf-card-field-label">{{this.label}}</span>
                                <input type="color" name="{{this.path}}" class="yf-color-swatch yf-live-input" value="{{this.value}}">
                                <span class="yf-token-badge" title="{{this.statusTitle}}">{{this.statusLabel}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetCardToken" data-token="{{this.path}}" title="{{this.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                            {{/each}}
                        </div>
                    </article>
                    {{/each}}
                </div>
            </section>

            <section class="yf-section">
                <div class="yf-section-header">
                    <i class="fas fa-shield-halved"></i>
                    <h3>{{localize "YOUR_FLAVOR.Config.CardTabs.Systems"}}</h3>
                </div>
                <div class="yf-readonly-grid yf-readonly-grid-sm">
                    {{#each cardTabs.systems}}
                    <article class="yf-readonly-card yf-card-system-card">
                        <span>{{this.label}}</span>
                        <strong>{{#if this.enabled}}{{localize "YOUR_FLAVOR.Config.TabStatus.Available"}}{{else}}{{localize "YOUR_FLAVOR.Config.TabStatus.Disabled"}}{{/if}}</strong>
                        <label class="yf-toggle-switch yf-toggle-mini" title="{{localize 'YOUR_FLAVOR.Config.CardTabs.SystemEnabledTitle'}}">
                            <input type="checkbox" name="{{this.path}}" {{#if this.enabled}}checked{{/if}}>
                            <span class="yf-toggle-slider"></span>
                        </label>
                    </article>
                    {{/each}}
                </div>
            </section>
            {{/if}}
            {{/unless}}

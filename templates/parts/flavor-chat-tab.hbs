            {{! ══════════════ CHAT TAB ══════════════ }}
            {{#unless canCustomize}}
            <div class="yf-notice yf-notice-warning">
                <i class="fas fa-lock"></i>
                <span>{{localize "YOUR_FLAVOR.Config.NoPermission"}}</span>
            </div>
            {{else}}
                {{#if hasForcedLayout}}
                <div class="yf-notice yf-notice-info">
                    <i class="fas fa-info-circle"></i>
                    <span>{{localize "YOUR_FLAVOR.Config.ForcedLayout"}} <strong>{{forcedLayoutName}}</strong></span>
                </div>
                {{/if}}
            {{/unless}}

            {{#if canCustomize}}
            {{#unless hasForcedLayout}}
            {{#if hasActors}}
            <div class="yf-actor-selector">
                <label><i class="fas fa-user"></i> {{localize "YOUR_FLAVOR.Config.ConfigFor"}}</label>
                <select class="yf-actor-select yf-select">
                    <option value="">{{localize "YOUR_FLAVOR.Config.DefaultStyle"}} ({{playerName}})</option>
                    {{#each ownedActors}}
                    <option value="{{this.id}}" {{#if (eq this.id ../editingActorId)}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            {{/if}}
            {{/unless}}
            {{/if}}

            {{#if canCustomize}}
            {{#unless hasForcedLayout}}
            <div class="yf-enable-row">
                <span class="yf-enable-label">{{localize "YOUR_FLAVOR.Config.Enable"}}</span>
                <label class="yf-toggle-switch">
                    <input type="checkbox" name="enabled" {{#if config.enabled}}checked{{/if}}>
                    <span class="yf-toggle-slider"></span>
                </label>
            </div>
            {{/unless}}
            {{/if}}

            {{#if canCustomize}}
            {{#unless hasForcedLayout}}
            <section class="yf-section">
                <div class="yf-section-header">
                    <i class="fas fa-th-large"></i>
                    <h3>{{localize "YOUR_FLAVOR.Config.LayoutSection"}}</h3>
                    <div class="yf-section-actions">
                        <button type="button" class="yf-btn yf-btn-secondary yf-btn-compact" data-action="exportUserPreset" title="{{localize 'YOUR_FLAVOR.Config.Presets.ExportTitle'}}">
                            <i class="fas fa-file-export"></i> <span class="yf-btn-label">{{localize "YOUR_FLAVOR.Config.Presets.ExportButton"}}</span>
                        </button>
                        <button type="button" class="yf-btn yf-btn-secondary yf-btn-compact" data-action="importUserPreset" title="{{localize 'YOUR_FLAVOR.Config.Presets.ImportTitle'}}">
                            <i class="fas fa-file-import"></i> <span class="yf-btn-label">{{localize "YOUR_FLAVOR.Config.Presets.ImportButton"}}</span>
                        </button>
                        <button type="button" class="yf-btn yf-btn-secondary yf-btn-compact" data-action="randomizeChat" title="{{randomizer.actionTitle}}">
                            <i class="fas fa-shuffle"></i> <span class="yf-btn-label">{{localize "YOUR_FLAVOR.Config.Randomizer.Action"}}</span>
                        </button>
                    </div>
                </div>
                <div class="yf-category-tags">
                    {{#if hasFavorites}}<span class="yf-tag yf-tag-fav" data-category="favorites"><i class="fas fa-star"></i> {{localize "YOUR_FLAVOR.Categories.Favorites"}}</span>{{/if}}
                    <span class="yf-tag" data-category="basic">{{localize "YOUR_FLAVOR.Categories.Basic"}}</span>
                    <span class="yf-tag" data-category="class">{{localize "YOUR_FLAVOR.Categories.Classes"}}</span>
                    <span class="yf-tag" data-category="race">{{localize "YOUR_FLAVOR.Categories.Races"}}</span>
                    <span class="yf-tag" data-category="theme">{{localize "YOUR_FLAVOR.Categories.Themes"}}</span>
                    <span class="yf-tag" data-category="modern">{{localize "YOUR_FLAVOR.Categories.Modern"}}</span>
                    <span class="yf-tag" data-category="misc">{{localize "YOUR_FLAVOR.Categories.Misc"}}</span>
                </div>
                <div class="yf-randomizer-panel">
                    <label>
                        <span>{{localize "YOUR_FLAVOR.Config.Randomizer.Tone"}}</span>
                        <select class="yf-select yf-randomizer-constraint" data-constraint="tone">
                            {{#each randomizer.toneOptions}}
                            <option value="{{this.value}}" {{#if this.isSelected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label>
                        <span>{{localize "YOUR_FLAVOR.Config.Randomizer.Intensity"}}</span>
                        <select class="yf-select yf-randomizer-constraint" data-constraint="intensity">
                            {{#each randomizer.intensityOptions}}
                            <option value="{{this.value}}" {{#if this.isSelected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label>
                        <span>{{localize "YOUR_FLAVOR.Config.Randomizer.Motion"}}</span>
                        <select class="yf-select yf-randomizer-constraint" data-constraint="motion">
                            {{#each randomizer.motionOptions}}
                            <option value="{{this.value}}" {{#if this.isSelected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <div class="yf-randomizer-context">
                        <span><i class="fas fa-crosshairs"></i> {{randomizer.scopeLabel}}</span>
                        <span><i class="fas fa-filter"></i> {{randomizer.filterLabel}}</span>
                    </div>
                </div>
                <div class="yf-layout-grid">
                    {{#each layouts}}
                    <div class="yf-layout-option {{#if (eq this.id ../config.layout)}}selected{{/if}} {{#if this.isEdited}}is-edited{{/if}}"
                         data-layout="{{this.id}}"
                         data-category="{{this.category}}"
                         data-preset-tone="{{this.metadata.tone.value}}"
                         data-preset-intensity="{{this.metadata.intensity.value}}"
                         data-preset-motion="{{this.metadata.motion.value}}"
                         data-preset-areas="{{this.metadata.compatibleAreasString}}"
                         data-preset-tags="{{this.metadata.tagsString}}"
                         title="{{this.tooltip}}">
                        <div class="yf-layout-icon"><i class="{{this.icon}}"></i></div>
                        <div class="yf-layout-name">{{this.name}}</div>
                        <div class="yf-layout-metadata" aria-label="{{this.metadata.title}}">
                            {{#each this.metadata.badges}}
                            <span class="yf-layout-meta-pill yf-layout-meta-{{this.type}} yf-layout-meta-{{this.value}}" title="{{this.title}}">
                                <i class="{{this.icon}}"></i>
                                <span>{{this.shortLabel}}</span>
                            </span>
                            {{/each}}
                        </div>
                        {{#if this.metadata.previewTags}}
                        <div class="yf-layout-tag-row">
                            {{#each this.metadata.previewTags}}
                            <span class="yf-layout-tag" title="{{this.title}}">{{this.label}}</span>
                            {{/each}}
                        </div>
                        {{/if}}
                        {{#if this.metadata.areas}}
                        <div class="yf-layout-areas" title="{{this.metadata.title}}">
                            {{#each this.metadata.areas}}
                            <i class="{{this.icon}}" title="{{this.title}}"></i>
                            {{/each}}
                        </div>
                        {{/if}}
                        {{#if this.isEdited}}
                        <span class="yf-preset-edited-badge" title="{{this.editedTitle}}"><i class="fas fa-pen"></i></span>
                        {{/if}}
                        {{#unless (eq this.id "none")}}
                        <button type="button" class="yf-fav-btn {{#if this.isFavorite}}active{{/if}}" data-action="toggleFavorite" title="{{localize 'YOUR_FLAVOR.Config.Favorite'}}">
                            <i class="{{#if this.isFavorite}}fas{{else}}far{{/if}} fa-star"></i>
                        </button>
                        {{/unless}}
                    </div>
                    {{/each}}
                </div>
            </section>
            {{/unless}}
            {{/if}}

            {{#if canCustomize}}
            {{#unless hasForcedLayout}}
            {{#if showCustomization}}
            <section class="yf-section yf-customization-section">
                <div class="yf-section-header">
                    <i class="fas fa-sliders-h"></i>
                    <h3>{{localize "YOUR_FLAVOR.Config.CustomizeSection"}}</h3>
                </div>
                <div class="yf-customize-grid">
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.FontFamily"}}</label>
                        <div class="yf-token-control {{tokenStates.fontFamily.statusClass}}">
                            <select name="customizations.fontFamily" class="yf-select">
                                {{#each fonts}}
                                <option value="{{this.family}}" {{#if (eq this.family ../config.customizations.fontFamily)}}selected{{/if}}>{{this.name}}</option>
                                {{/each}}
                            </select>
                            <span class="yf-token-badge" title="{{tokenStates.fontFamily.title}}">{{tokenStates.fontFamily.label}}</span>
                            <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.fontFamily" title="{{tokenStates.fontFamily.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.FontSize"}}</label>
                        <div class="yf-token-control {{tokenStates.fontSize.statusClass}}">
                            <div class="yf-range-wrapper">
                                <input type="range" name="customizations.fontSize" class="yf-range" min="10" max="24" value="{{config.customizations.fontSize}}">
                                <span class="yf-range-value">{{config.customizations.fontSize}}px</span>
                            </div>
                            <span class="yf-token-badge" title="{{tokenStates.fontSize.title}}">{{tokenStates.fontSize.label}}</span>
                            <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.fontSize" title="{{tokenStates.fontSize.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.Colors"}}</label>
                        <div class="yf-color-row">
                            <div class="yf-token-control yf-token-color-control {{tokenStates.textColor.statusClass}}">
                                <input type="color" name="customizations.textColor" class="yf-color-swatch" value="{{config.customizations.textColor}}" title="{{localize 'YOUR_FLAVOR.Config.TextColor'}}">
                                <span class="yf-token-badge" title="{{tokenStates.textColor.title}}">{{tokenStates.textColor.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.textColor" title="{{tokenStates.textColor.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                            <div class="yf-token-control yf-token-color-control {{tokenStates.backgroundColor.statusClass}}">
                                <input type="color" name="customizations.backgroundColor" class="yf-color-swatch" value="{{backgroundColorHex}}" title="{{localize 'YOUR_FLAVOR.Config.BackgroundColor'}}">
                                <span class="yf-token-badge" title="{{tokenStates.backgroundColor.title}}">{{tokenStates.backgroundColor.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.backgroundColor" title="{{tokenStates.backgroundColor.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                            <div class="yf-token-control yf-token-color-control {{tokenStates.borderColor.statusClass}}">
                                <input type="color" name="customizations.borderColor" class="yf-color-swatch" value="{{config.customizations.borderColor}}" title="{{localize 'YOUR_FLAVOR.Config.BorderColor'}}">
                                <span class="yf-token-badge" title="{{tokenStates.borderColor.title}}">{{tokenStates.borderColor.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.borderColor" title="{{tokenStates.borderColor.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.Opacity"}}</label>
                        <div class="yf-token-control {{tokenStates.backgroundOpacity.statusClass}}">
                            <div class="yf-range-wrapper">
                                <input type="range" name="customizations.backgroundOpacity" class="yf-range" min="0" max="100" step="5" value="{{config.customizations.backgroundOpacity}}">
                                <span class="yf-range-value">{{config.customizations.backgroundOpacity}}%</span>
                            </div>
                            <span class="yf-token-badge" title="{{tokenStates.backgroundOpacity.title}}">{{tokenStates.backgroundOpacity.label}}</span>
                            <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.backgroundOpacity" title="{{tokenStates.backgroundOpacity.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.NameTimestampColors"}}</label>
                        <div class="yf-color-row">
                            <div class="yf-token-control yf-token-color-control {{tokenStates.nameColor.statusClass}}">
                                <input type="color" name="customizations.nameColor" class="yf-color-swatch" value="{{#if config.customizations.nameColor}}{{config.customizations.nameColor}}{{else}}{{config.customizations.borderColor}}{{/if}}" title="{{localize 'YOUR_FLAVOR.Config.NameColor'}}">
                                <span class="yf-token-badge" title="{{tokenStates.nameColor.title}}">{{tokenStates.nameColor.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.nameColor" title="{{tokenStates.nameColor.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                            <div class="yf-token-control yf-token-color-control {{tokenStates.timestampColor.statusClass}}">
                                <input type="color" name="customizations.timestampColor" class="yf-color-swatch" value="{{#if config.customizations.timestampColor}}{{config.customizations.timestampColor}}{{else}}{{config.customizations.textColor}}{{/if}}" title="{{localize 'YOUR_FLAVOR.Config.TimestampColor'}}">
                                <span class="yf-token-badge" title="{{tokenStates.timestampColor.title}}">{{tokenStates.timestampColor.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.timestampColor" title="{{tokenStates.timestampColor.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.BorderStyle"}}</label>
                        <div class="yf-token-control {{tokenStates.borderStyle.statusClass}}">
                            <select name="customizations.borderStyle" class="yf-select">
                                <option value="solid" {{#if (eq config.customizations.borderStyle "solid")}}selected{{/if}}>Solid</option>
                                <option value="dashed" {{#if (eq config.customizations.borderStyle "dashed")}}selected{{/if}}>Dashed</option>
                                <option value="dotted" {{#if (eq config.customizations.borderStyle "dotted")}}selected{{/if}}>Dotted</option>
                                <option value="double" {{#if (eq config.customizations.borderStyle "double")}}selected{{/if}}>Double</option>
                                <option value="groove" {{#if (eq config.customizations.borderStyle "groove")}}selected{{/if}}>Groove</option>
                                <option value="ridge" {{#if (eq config.customizations.borderStyle "ridge")}}selected{{/if}}>Ridge</option>
                            </select>
                            <span class="yf-token-badge" title="{{tokenStates.borderStyle.title}}">{{tokenStates.borderStyle.label}}</span>
                            <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.borderStyle" title="{{tokenStates.borderStyle.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.BorderWidth"}}</label>
                        <div class="yf-token-control {{tokenStates.borderWidth.statusClass}}">
                            <div class="yf-range-wrapper">
                                <input type="range" name="customizations.borderWidth" class="yf-range" min="0" max="8" value="{{config.customizations.borderWidth}}">
                                <span class="yf-range-value">{{config.customizations.borderWidth}}px</span>
                            </div>
                            <span class="yf-token-badge" title="{{tokenStates.borderWidth.title}}">{{tokenStates.borderWidth.label}}</span>
                            <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.borderWidth" title="{{tokenStates.borderWidth.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.BorderRadius"}}</label>
                        <div class="yf-token-control {{tokenStates.borderRadius.statusClass}}">
                            <div class="yf-range-wrapper">
                                <input type="range" name="customizations.borderRadius" class="yf-range" min="0" max="50" value="{{config.customizations.borderRadius}}">
                                <span class="yf-range-value">{{config.customizations.borderRadius}}px</span>
                            </div>
                            <span class="yf-token-badge" title="{{tokenStates.borderRadius.title}}">{{tokenStates.borderRadius.label}}</span>
                            <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.borderRadius" title="{{tokenStates.borderRadius.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                        </div>
                    </div>
                    <div class="yf-control-row">
                        <label>{{localize "YOUR_FLAVOR.Config.Effects"}}</label>
                        <div class="yf-effects-row">
                            <div class="yf-token-control yf-token-toggle-control {{tokenStates.glowEnabled.statusClass}}">
                                <label class="yf-toggle-switch yf-toggle-mini" title="{{localize 'YOUR_FLAVOR.Config.GlowEnabled'}}"><input type="checkbox" name="customizations.glowEnabled" {{#if config.customizations.glowEnabled}}checked{{/if}}><span class="yf-toggle-slider"></span></label>
                                <span class="yf-effect-label">{{localize "YOUR_FLAVOR.Config.Glow"}}</span>
                                <span class="yf-token-badge" title="{{tokenStates.glowEnabled.title}}">{{tokenStates.glowEnabled.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.glowEnabled" title="{{tokenStates.glowEnabled.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                            <div class="yf-token-control yf-token-toggle-control {{tokenStates.shadowEnabled.statusClass}}">
                                <label class="yf-toggle-switch yf-toggle-mini" title="{{localize 'YOUR_FLAVOR.Config.ShadowEnabled'}}"><input type="checkbox" name="customizations.shadowEnabled" {{#if config.customizations.shadowEnabled}}checked{{/if}}><span class="yf-toggle-slider"></span></label>
                                <span class="yf-effect-label">{{localize "YOUR_FLAVOR.Config.Shadow"}}</span>
                                <span class="yf-token-badge" title="{{tokenStates.shadowEnabled.title}}">{{tokenStates.shadowEnabled.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.shadowEnabled" title="{{tokenStates.shadowEnabled.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                        </div>
                    </div>
                    {{#if config.customizations.glowEnabled}}
                    <div class="yf-sub-options">
                        <div class="yf-control-row">
                            <label>{{localize "YOUR_FLAVOR.Config.GlowColor"}}</label>
                            <div class="yf-color-row">
                                <div class="yf-token-control yf-token-color-control {{tokenStates.glowColor.statusClass}}">
                                    <input type="color" name="customizations.glowColor" class="yf-color-swatch" value="{{config.customizations.glowColor}}">
                                    <span class="yf-token-badge" title="{{tokenStates.glowColor.title}}">{{tokenStates.glowColor.label}}</span>
                                    <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.glowColor" title="{{tokenStates.glowColor.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="yf-control-row">
                            <label>{{localize "YOUR_FLAVOR.Config.GlowIntensity"}}</label>
                            <div class="yf-token-control {{tokenStates.glowIntensity.statusClass}}">
                                <div class="yf-range-wrapper">
                                    <input type="range" name="customizations.glowIntensity" class="yf-range" min="5" max="25" value="{{config.customizations.glowIntensity}}">
                                    <span class="yf-range-value">{{config.customizations.glowIntensity}}px</span>
                                </div>
                                <span class="yf-token-badge" title="{{tokenStates.glowIntensity.title}}">{{tokenStates.glowIntensity.label}}</span>
                                <button type="button" class="yf-token-reset" data-action="resetChatToken" data-token="customizations.glowIntensity" title="{{tokenStates.glowIntensity.resetTitle}}"><i class="fas fa-rotate-left"></i></button>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                </div>
            </section>
            {{/if}}
            {{/unless}}
            {{/if}}

            {{#if canCustomize}}
            {{#unless hasForcedLayout}}
            {{#if allowCustomHtml}}
            <section class="yf-section yf-advanced-section">
                <div class="yf-advanced-toggle" data-action="toggleAdvanced">
                    <i class="fas fa-chevron-right"></i>
                    <span>{{localize "YOUR_FLAVOR.Config.AdvancedSection"}}</span>
                </div>
                <div class="yf-advanced-content">
                    <div class="yf-warning-box">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>{{localize "YOUR_FLAVOR.Config.AdvancedWarning"}}</span>
                    </div>
                    <textarea name="customHtml" class="yf-textarea" placeholder="{{localize 'YOUR_FLAVOR.Config.CustomHtmlPlaceholder'}}">{{config.customHtml}}</textarea>
                </div>
            </section>
            {{/if}}
            {{/unless}}
            {{/if}}

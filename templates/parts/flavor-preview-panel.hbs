                         tabindex="0"
                         aria-pressed="{{#if this.isActive}}true{{else}}false{{/if}}"
                         title="{{this.description}}">
                    <div class="yf-preview-fixture-head">
                        <span class="yf-preview-fixture-label">{{this.label}}</span>
                        <span class="yf-preview-fixture-group">{{this.groupLabel}}</span>

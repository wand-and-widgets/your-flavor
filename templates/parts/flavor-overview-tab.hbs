            {{! ══════════════ OVERVIEW — HOME ══════════════ }}
            <div class="yf-home" data-yf-overview>
                <header class="yf-home-greeting">
                    <h2>{{overview.greeting}} {{playerName}}</h2>
                    <p>{{localize "YOUR_FLAVOR.Studio.HomeTab.Sub"}}</p>
                </header>

                <section class="yf-home-workbench" aria-labelledby="yf-home-workbench-title">
                    <div class="yf-home-section-title">
                        <span aria-hidden="true"></span>
                        <h3 id="yf-home-workbench-title">{{localize "YOUR_FLAVOR.Studio.HomeTab.SectionHeading"}}</h3>
                        <i aria-hidden="true"></i>
                    </div>

                    <div class="yf-home-cards">
                        {{#each tabs}}
                        {{#unless (eq this.id "overview")}}
                        <article class="yf-home-card yf-home-card-{{this.id}} {{#if this.isDirty}}is-dirty{{/if}}" data-area="{{this.id}}">
                            <button type="button" class="yf-home-card-main" data-action="switchTab" data-tab="{{this.id}}" {{#if this.homeHelp}}title="{{this.homeHelp}}"{{/if}}>
                                <span class="yf-home-card-medallion" aria-hidden="true">
                                    <img class="yf-home-medallion-frame" src="modules/your-flavor/assets/ui/overview/frames/medallion-frame-v1.svg" alt="">
                                    <img class="yf-home-medallion-glyph" src="modules/your-flavor/assets/ui/overview/icons/{{this.iconAssetId}}-glyph-v1.svg" alt="">
                                    <span class="yf-home-dirty" title="{{this.dirtyTitle}}" {{#unless this.isDirty}}hidden{{/unless}}></span>
                                </span>
                                <span class="yf-home-card-copy">
                                    <strong>{{this.label}}</strong>
                                    {{#if this.homeDesc}}<small>{{this.homeDesc}}</small>{{/if}}
                                </span>
                                <span class="yf-home-card-arrow" aria-hidden="true">›</span>
                            </button>
                        </article>
                        {{/unless}}
                        {{/each}}
                    </div>
                </section>

                <section class="yf-home-share" aria-label="{{localize 'YOUR_FLAVOR.Config.VisualShare.Title'}}">
                    <span class="yf-home-share-seal" aria-hidden="true">
                        <img src="modules/your-flavor/assets/ui/overview/frames/medallion-frame-v1.svg" alt="">
                        <img src="modules/your-flavor/assets/ui/overview/icons/share-glyph-v1.svg" alt="">
                    </span>
                    <div class="yf-home-share-copy">
                        <strong>{{localize "YOUR_FLAVOR.Studio.HomeTab.ShareHeading"}}</strong>
                        <small>{{localize "YOUR_FLAVOR.Config.VisualShare.Heading"}}</small>
                    </div>
                    <div class="yf-home-share-actions">
                        <button type="button" class="yf-btn yf-btn-secondary yf-home-share-button" data-action="exportVisual" title='{{localize "YOUR_FLAVOR.Config.VisualShare.ExportTitle"}}'>
                            <i class="fas fa-upload"></i>
                            <span>{{localize "YOUR_FLAVOR.Config.VisualShare.ExportButton"}}</span>
                        </button>
                        <button type="button" class="yf-btn yf-btn-secondary yf-home-share-button" data-action="importVisual" title='{{localize "YOUR_FLAVOR.Config.VisualShare.ImportTitle"}}' {{#unless overview.visualShare.canImport}}disabled{{/unless}}>
                            <i class="fas fa-download"></i>
                            <span>{{localize "YOUR_FLAVOR.Config.VisualShare.ImportButton"}}</span>
                        </button>
                    </div>
                </section>
            </div>

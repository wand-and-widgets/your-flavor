<div class="yf-foundry-section-shell">
    <nav class="yf-foundry-section-menu" aria-label="{{localize 'YOUR_FLAVOR.Config.Tabs.FoundryShell'}}">
        {{#each foundrySections}}
        <button type="button" class="yf-foundry-section-tab {{#if this.isActive}}is-active{{/if}} {{#unless this.isAvailable}}is-disabled{{/unless}}" data-action="switchFoundrySection" data-section="{{this.id}}" aria-pressed="{{#if this.isActive}}true{{else}}false{{/if}}" title="{{this.title}}" {{#unless this.isAvailable}}disabled{{/unless}}>
            <i class="{{this.icon}}"></i>
            <span>{{this.label}}</span>
        </button>
        {{/each}}
    </nav>

    {{#if (eq activeFoundrySection "overview")}}
    <div class="yf-notice yf-notice-warning">
        <i class="fas fa-radiation"></i>
        <span>{{localize "YOUR_FLAVOR.Config.Foundry.Warning"}}</span>
    </div>

    <div class="yf-enable-row">
        <span class="yf-enable-label">{{localize "YOUR_FLAVOR.Config.Foundry.Enable"}}</span>
        <label class="yf-toggle-switch">
            <input type="checkbox" name="foundry.enabled" {{#if foundryConfig.enabled}}checked{{/if}}>
            <span class="yf-toggle-slider"></span>
        </label>
    </div>

    <section class="yf-section yf-foundry-stock-reset-section">
        <div class="yf-section-header">
            <i class="fas fa-broom"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.StockResetSection"}}</h3>
        </div>
        <div class="yf-foundry-stock-reset-card">
            <div class="yf-foundry-stock-reset-copy">
                <strong>{{localize "YOUR_FLAVOR.Config.Foundry.StockResetHeading"}}</strong>
                <span>{{localize "YOUR_FLAVOR.Config.Foundry.StockResetDescription"}}</span>
            </div>
            <button type="button" class="yf-btn yf-btn-danger" data-action="resetFoundryStock" title='{{localize "YOUR_FLAVOR.Config.Foundry.StockResetButtonTitle"}}' aria-label='{{localize "YOUR_FLAVOR.Config.Foundry.StockResetButtonTitle"}}'>
                <i class="fas fa-rotate-left"></i>
                <span>{{localize "YOUR_FLAVOR.Config.Foundry.StockResetButton"}}</span>
            </button>
        </div>
    </section>

    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-layer-group"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.AreasSection"}}</h3>
        </div>
        <p class="yf-section-hint">{{localize "YOUR_FLAVOR.Config.Foundry.AreasHint"}}</p>
        <div class="yf-foundry-visibility-grid">
            {{#each foundryAreas}}
            <div class="yf-foundry-toggle-card yf-foundry-area-card">
                <button type="button" class="yf-area-link" data-action="switchFoundrySection" data-section="{{this.id}}">
                    <span>{{this.label}}</span>
                </button>
                <div class="yf-foundry-card-actions">
                    <button type="button" class="yf-btn-ghost" data-action="exportConfig" data-area="{{this.id}}" title="{{this.exportTitle}}" aria-label="{{this.exportTitle}}">
                        <i class="fas fa-file-export"></i>
                    </button>
                    <label class="yf-toggle-switch yf-toggle-mini" title="{{localize 'YOUR_FLAVOR.Config.Foundry.AreaEnabled'}}">
                        <input type="checkbox" name="foundry.areaEnabled.{{this.id}}" {{#if this.enabled}}checked{{/if}}>
                        <span class="yf-toggle-slider"></span>
                    </label>
                </div>
            </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

    {{#if (eq activeFoundrySection "global")}}
    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-swatchbook"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.PresetsSection"}}</h3>
        </div>
        <p class="yf-section-hint">{{localize "YOUR_FLAVOR.Config.Foundry.GlobalHint"}}</p>
        <div class="yf-preset-grid">
            {{#each themePresets}}
            <button type="button" class="yf-preset-chip" data-action="applyThemePreset" data-preset="{{this.id}}" title="{{this.label}}">
                <i class="{{this.icon}}"></i>
                <span>{{this.label}}</span>
            </button>
            {{/each}}
        </div>
    </section>

    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-palette"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.ThemeSection"}}</h3>
        </div>
        <div class="yf-customize-grid">
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.InterfaceFont"}}</label>
                <select name="foundry.theme.interfaceFont" class="yf-select">
                    {{#each foundryFonts}}
                    <option value="{{this.family}}" {{#if (eq this.family ../foundryConfig.theme.interfaceFont)}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.WindowFont"}}</label>
                <select name="foundry.theme.windowFont" class="yf-select">
                    {{#each foundryFonts}}
                    <option value="{{this.family}}" {{#if (eq this.family ../foundryConfig.theme.windowFont)}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.ThemeColors"}}</label>
                <div class="yf-color-grid">
                    {{#each foundryThemeFields}}
                    <label class="yf-color-chip yf-nullable-color-chip {{#if this.isStock}}is-stock{{/if}}">
                        <span>{{this.label}}</span>
                        <input type="color" name="{{this.name}}" class="yf-color-swatch yf-nullable-color {{#if this.isStock}}is-stock{{/if}}" value="{{this.value}}" data-nullable-color="true" data-stock="{{#if this.isStock}}true{{else}}false{{/if}}" data-stock-label="{{this.stockLabel}}" data-clear-title="{{this.clearTitle}}">
                        {{#if this.isStock}}<small>{{this.stockLabel}}</small>{{/if}}
                    </label>
                    {{/each}}
                </div>
            </div>
        </div>
    </section>
    {{/if}}

    {{#if foundryActiveAreaPage}}
    <section class="yf-section yf-foundry-area-page">
        <div class="yf-foundry-area-page-header">
            <div>
                <div class="yf-section-header">
                    <i class="{{foundryActiveAreaPage.icon}}"></i>
                    <h3>{{foundryActiveAreaPage.label}}</h3>
                </div>
                <p class="yf-section-hint">{{foundryActiveAreaPage.description}}</p>
            </div>
            <button type="button" class="yf-btn-ghost" data-action="exportConfig" data-area="{{foundryActiveAreaPage.areaId}}" title="{{foundryActiveAreaPage.exportTitle}}" aria-label="{{foundryActiveAreaPage.exportTitle}}">
                <i class="fas fa-file-export"></i>
            </button>
        </div>

        <div class="yf-foundry-area-control-grid">
            <div class="yf-foundry-toggle-card">
                <span>{{localize "YOUR_FLAVOR.Config.Foundry.AreaEnabled"}}</span>
                <label class="yf-toggle-switch yf-toggle-mini">
                    <input type="checkbox" name="{{foundryActiveAreaPage.areaEnabledName}}" {{#if foundryActiveAreaPage.enabled}}checked{{/if}}>
                    <span class="yf-toggle-slider"></span>
                </label>
            </div>
            {{#if foundryActiveAreaPage.showVisibility}}
            <div class="yf-foundry-toggle-card">
                <span>{{localize "YOUR_FLAVOR.Config.Foundry.AreaVisible"}}</span>
                <label class="yf-toggle-switch yf-toggle-mini">
                    <input type="checkbox" name="{{foundryActiveAreaPage.visibilityName}}" {{#if foundryActiveAreaPage.visible}}checked{{/if}}>
                    <span class="yf-toggle-slider"></span>
                </label>
            </div>
            {{/if}}
        </div>

        {{#unless foundryConfig.enabled}}
        <div class="yf-notice yf-notice-warning">
            <i class="fas fa-power-off"></i>
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.DisabledAreaNotice"}}</span>
        </div>
        {{/unless}}
    </section>

    {{#if foundryActiveAreaPage.themeFields.length}}
    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-palette"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.AreaThemeSection"}}</h3>
        </div>
        <div class="yf-color-grid">
            {{#each foundryActiveAreaPage.themeFields}}
            <label class="yf-color-chip yf-nullable-color-chip {{#if this.isStock}}is-stock{{/if}}">
                <span>{{this.label}}</span>
                <input type="color" name="{{this.name}}" class="yf-color-swatch yf-nullable-color {{#if this.isStock}}is-stock{{/if}}" value="{{this.value}}" data-nullable-color="true" data-stock="{{#if this.isStock}}true{{else}}false{{/if}}" data-stock-label="{{this.stockLabel}}" data-clear-title="{{this.clearTitle}}">
                {{#if this.isStock}}<small>{{this.stockLabel}}</small>{{/if}}
            </label>
            {{/each}}
        </div>
    </section>
    {{/if}}

    {{#if foundryActiveAreaPage.isNavigation}}
    {{#with foundryActiveAreaPage.sceneNavigation}}
    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-font"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationTypographySection"}}</h3>
        </div>
        <div class="yf-customize-grid">
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationFont"}}</label>
                <select name="foundry.sceneNavigation.fontFamily" class="yf-select">
                    {{#each ../foundryFonts}}
                    <option value="{{this.family}}" {{#if (eq this.family ../fontFamily)}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationFontSize"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.fontSize" class="yf-range" min="9" max="24" step="1" value="{{this.fontSize}}">
                    <span class="yf-range-value">{{this.fontSize}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationFontWeight"}}</label>
                <select name="foundry.sceneNavigation.fontWeight" class="yf-select">
                    {{#each this.fontWeightOptions}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationLetterSpacing"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.letterSpacing" class="yf-range" min="0" max="8" step="0.1" value="{{this.letterSpacing}}">
                    <span class="yf-range-value">{{this.letterSpacing}}px</span>
                </div>
            </div>
            <div class="yf-foundry-toggle-card">
                <span>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationUppercase"}}</span>
                <label class="yf-toggle-switch yf-toggle-mini">
                    <input type="checkbox" name="foundry.sceneNavigation.uppercase" {{#if this.uppercase}}checked{{/if}}>
                    <span class="yf-toggle-slider"></span>
                </label>
            </div>
        </div>
    </section>

    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-bars-staggered"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationRowsSection"}}</h3>
        </div>
        <div class="yf-foundry-layout-controls">
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationRowHeight"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.rowHeight" class="yf-range" min="20" max="64" step="1" value="{{this.rowHeight}}">
                    <span class="yf-range-value">{{this.rowHeight}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationPaddingX"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.paddingX" class="yf-range" min="0" max="32" step="1" value="{{this.paddingX}}">
                    <span class="yf-range-value">{{this.paddingX}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationPaddingY"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.paddingY" class="yf-range" min="0" max="20" step="1" value="{{this.paddingY}}">
                    <span class="yf-range-value">{{this.paddingY}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationGap"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.gap" class="yf-range" min="0" max="24" step="1" value="{{this.gap}}">
                    <span class="yf-range-value">{{this.gap}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationRadius"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.borderRadius" class="yf-range" min="0" max="40" step="1" value="{{this.borderRadius}}">
                    <span class="yf-range-value">{{this.borderRadius}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationBorder"}}</label>
                <div class="yf-inline-controls">
                    <select name="foundry.sceneNavigation.borderStyle" class="yf-select yf-select-sm">
                        {{#each this.borderStyleOptions}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <input type="number" name="foundry.sceneNavigation.borderWidth" class="yf-input yf-input-sm" min="0" max="8" value="{{this.borderWidth}}" placeholder="1">
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationLayoutMode"}}</label>
                <select name="foundry.sceneNavigation.layoutMode" class="yf-select">
                    {{#each this.layoutModeOptions}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
    </section>

    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-layer-group"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationStatesSection"}}</h3>
        </div>
        <div class="yf-customize-grid">
            {{#each this.colorGroups}}
            <div class="yf-control-row">
                <label>{{this.label}}</label>
                <div class="yf-color-grid">
                    {{#each this.controls}}
                    <label class="yf-color-chip yf-nullable-color-chip {{#if this.isStock}}is-stock{{/if}}">
                        <span>{{this.label}}</span>
                        <input type="color" name="{{this.name}}" class="yf-color-swatch yf-nullable-color {{#if this.isStock}}is-stock{{/if}}" value="{{this.value}}" data-nullable-color="true" data-stock="{{#if this.isStock}}true{{else}}false{{/if}}" data-stock-label="{{this.stockLabel}}" data-clear-title="{{this.clearTitle}}">
                        {{#if this.isStock}}<small>{{this.stockLabel}}</small>{{/if}}
                    </label>
                    {{/each}}
                </div>
            </div>
            {{/each}}
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.SceneNavigationHiddenOpacity"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.sceneNavigation.hiddenOpacity" class="yf-range" min="10" max="100" step="5" value="{{this.hiddenOpacity}}">
                    <span class="yf-range-value">{{this.hiddenOpacity}}%</span>
                </div>
            </div>
        </div>
    </section>
    {{/with}}
    {{/if}}

    {{#if foundryActiveAreaPage.isControls}}
    {{#with foundryActiveAreaPage.tokenControls}}
    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-palette"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsStateColors"}}</h3>
        </div>
        <div class="yf-color-grid">
            {{#each this.colorGroups}}
            {{#each this.controls}}
            <label class="yf-color-chip yf-nullable-color-chip {{#if this.isStock}}is-stock{{/if}}">
                <span>{{../label}}: {{this.label}}</span>
                <input type="color" name="{{this.name}}" class="yf-color-swatch yf-nullable-color {{#if this.isStock}}is-stock{{/if}}" value="{{this.value}}" data-nullable-color="true" data-stock="{{#if this.isStock}}true{{else}}false{{/if}}" data-stock-label="{{this.stockLabel}}" data-clear-title="{{this.clearTitle}}">
                {{#if this.isStock}}<small>{{this.stockLabel}}</small>{{/if}}
            </label>
            {{/each}}
            {{/each}}
        </div>
    </section>

    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-grip-vertical"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsGeometrySection"}}</h3>
        </div>
        <p class="yf-section-hint">{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsHint"}}</p>
        <div class="yf-foundry-layout-controls">
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsButtonSize"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.tokenControls.buttonSize" class="yf-range" min="24" max="56" step="1" value="{{this.buttonSize}}">
                    <span class="yf-range-value">{{this.buttonSize}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsIconSize"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.tokenControls.iconSize" class="yf-range" min="10" max="32" step="1" value="{{this.iconSize}}">
                    <span class="yf-range-value">{{this.iconSize}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsGap"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.tokenControls.gap" class="yf-range" min="0" max="24" step="1" value="{{this.gap}}">
                    <span class="yf-range-value">{{this.gap}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsColumnGap"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.tokenControls.columnGap" class="yf-range" min="0" max="32" step="1" value="{{this.columnGap}}">
                    <span class="yf-range-value">{{this.columnGap}}px</span>
                </div>
            </div>
        </div>
    </section>

    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-square"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsButtonSection"}}</h3>
        </div>
        <div class="yf-foundry-layout-controls">
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsRadius"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.tokenControls.borderRadius" class="yf-range" min="0" max="24" step="1" value="{{this.borderRadius}}">
                    <span class="yf-range-value">{{this.borderRadius}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsBorder"}}</label>
                <div class="yf-inline-controls">
                    <select name="foundry.tokenControls.borderStyle" class="yf-select yf-select-sm">
                        {{#each this.borderStyleOptions}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <input type="number" name="foundry.tokenControls.borderWidth" class="yf-input yf-input-sm" min="0" max="6" value="{{this.borderWidth}}" placeholder="1">
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsShadow"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.tokenControls.shadowIntensity" class="yf-range" min="0" max="32" step="1" value="{{this.shadowIntensity}}">
                    <span class="yf-range-value">{{this.shadowIntensity}}px</span>
                </div>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.TokenControlsDisabledOpacity"}}</label>
                <div class="yf-range-wrapper">
                    <input type="range" name="foundry.tokenControls.disabledOpacity" class="yf-range" min="10" max="100" step="5" value="{{this.disabledOpacity}}">
                    <span class="yf-range-value">{{this.disabledOpacity}}%</span>
                </div>
            </div>
        </div>
    </section>
    {{/with}}
    {{/if}}

    {{#if foundryActiveAreaPage.isHotbar}}
    {{#with foundryActiveAreaPage.hotbar}}
    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-layer-group"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.HotbarStatesSection"}}</h3>
        </div>
        <div class="yf-customize-grid">
            {{#each this.colorGroups}}
            <div class="yf-control-row">
                <label>{{this.label}}</label>
                <div class="yf-color-grid">
                    {{#each this.controls}}
                    <label class="yf-color-chip yf-nullable-color-chip {{#if this.isStock}}is-stock{{/if}}">
                        <span>{{this.label}}</span>
                        <input type="color" name="{{this.name}}" class="yf-color-swatch yf-nullable-color {{#if this.isStock}}is-stock{{/if}}" value="{{this.value}}" data-nullable-color="true" data-stock="{{#if this.isStock}}true{{else}}false{{/if}}" data-stock-label="{{this.stockLabel}}" data-clear-title="{{this.clearTitle}}">
                        {{#if this.isStock}}<small>{{this.stockLabel}}</small>{{/if}}
                    </label>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>
    </section>

    <section class="yf-section">
        <div class="yf-section-header">
            <i class="fas fa-location-dot"></i>
            <h3>{{localize "YOUR_FLAVOR.Config.Foundry.HotbarPositionSection"}}</h3>
        </div>
        <p class="yf-section-hint">{{localize "YOUR_FLAVOR.Config.Foundry.HotbarHint"}}</p>
        <div class="yf-foundry-layout-controls">
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.HotbarAnchor"}}</label>
                <select name="foundry.hotbar.anchor" class="yf-select">
                    {{#each this.anchorOptions}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="yf-control-row">
                <label>{{localize "YOUR_FLAVOR.Config.Foundry.HotbarOffsetX"}}</label>
                <div class="yf-range-wrapper">

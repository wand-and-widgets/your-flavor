<div class="yf-foundry-section-shell">
    {{#if isFoundryGlobal}}
    <header class="yf-foundry-overview-context yf-foundry-global-context">
        <div class="yf-foundry-overview-context-title">
            <span class="yf-foundry-overview-context-medallion" aria-hidden="true">
                <img src="modules/your-flavor/assets/ui/overview/icons/foundry-glyph-v1.svg" alt="">
            </span>
            <span>
                <strong>{{localize "YOUR_FLAVOR.Config.Tabs.FoundryShell"}}</strong>
                <small>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.Subtitle"}}</small>
            </span>
        </div>
        <div class="yf-foundry-overview-editing">
            <i class="fas fa-user-crown" aria-hidden="true"></i>
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.Editing"}}: <strong>{{playerName}}</strong></span>
        </div>
        <div class="yf-foundry-overview-master">
            <span>
                <strong>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.MasterLabel"}}</strong>
                <small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.MasterHint"}}</small>
            </span>
            <label class="yf-toggle-switch" title="{{localize 'YOUR_FLAVOR.Config.Foundry.Enable'}}">
                <input type="checkbox" name="foundry.enabled" {{#if foundryConfig.enabled}}checked{{/if}}>
                <span class="yf-toggle-slider"></span>
            </label>
        </div>
    </header>
    {{/if}}

    {{#unless (eq activeFoundrySection "overview")}}
    <nav class="yf-foundry-section-menu" aria-label="{{localize 'YOUR_FLAVOR.Config.Tabs.FoundryShell'}}">
        {{#each foundrySections}}
        <button type="button" class="yf-foundry-section-tab {{#if this.isActive}}is-active{{/if}} {{#unless this.isAvailable}}is-disabled{{/unless}}" data-action="switchFoundrySection" data-section="{{this.id}}" aria-pressed="{{#if this.isActive}}true{{else}}false{{/if}}" title="{{this.title}}" {{#unless this.isAvailable}}disabled{{/unless}}>
            <i class="{{this.icon}}"></i>
            <span>{{this.label}}</span>
        </button>
        {{/each}}
    </nav>
    {{/unless}}

    {{#if (eq activeFoundrySection "overview")}}
    <div class="yf-foundry-overview">
        <header class="yf-foundry-overview-context">
            <div class="yf-foundry-overview-context-title">
                <span class="yf-foundry-overview-context-medallion" aria-hidden="true">
                    <img src="modules/your-flavor/assets/ui/overview/icons/foundry-glyph-v1.svg" alt="">
                </span>
                <span>
                    <strong>{{localize "YOUR_FLAVOR.Config.Tabs.FoundryShell"}}</strong>
                    <small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.Subtitle"}}</small>
                </span>
            </div>
            <div class="yf-foundry-overview-editing">
                <i class="fas fa-user-crown" aria-hidden="true"></i>
                <span>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.Editing"}}: <strong>{{playerName}}</strong></span>
            </div>
            <div class="yf-foundry-overview-master">
                <span>
                    <strong>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.MasterLabel"}}</strong>
                    <small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.MasterHint"}}</small>
                </span>
                <label class="yf-toggle-switch" title="{{localize 'YOUR_FLAVOR.Config.Foundry.Enable'}}">
                    <input type="checkbox" name="foundry.enabled" {{#if foundryConfig.enabled}}checked{{/if}}>
                    <span class="yf-toggle-slider"></span>
                </label>
            </div>
        </header>

        <section class="yf-foundry-overview-hero" aria-labelledby="yf-foundry-overview-title">
            <div class="yf-foundry-overview-hero-medallion" aria-hidden="true">
                <img src="modules/your-flavor/assets/ui/overview/icons/foundry-glyph-v1.svg" alt="">
            </div>
            <div class="yf-foundry-overview-hero-copy">
                <span class="yf-foundry-overview-kicker">{{localize "YOUR_FLAVOR.Config.Tabs.FoundryShell"}}</span>
                <h2 id="yf-foundry-overview-title">{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.HeroTitle"}}</h2>
                <p>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.HeroDescription"}}</p>
                <ol class="yf-foundry-overview-steps" aria-label="{{localize 'YOUR_FLAVOR.Config.Foundry.OverviewHub.StepsLabel'}}">
                    <li><span>1</span>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.StepChoose"}}</li>
                    <li><span>2</span>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.StepRefine"}}</li>
                    <li><span>3</span>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.StepSave"}}</li>
                </ol>
            </div>
        </section>

        <section class="yf-foundry-overview-destinations" aria-labelledby="yf-foundry-destinations-title">
            <div class="yf-foundry-overview-heading">
                <span aria-hidden="true"></span>
                <h3 id="yf-foundry-destinations-title">{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.ChooseTitle"}}</h3>
                <span aria-hidden="true"></span>
            </div>

            <div class="yf-foundry-overview-group">
                <h4><i class="fas fa-compass" aria-hidden="true"></i>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.FoundationTitle"}}</h4>
                <div class="yf-foundry-overview-foundation-grid">
                    <button type="button" class="yf-foundry-destination-card is-foundation" data-action="switchFoundrySection" data-section="global">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-palette"></i></span>
                        <span class="yf-foundry-destination-copy">
                            <strong>{{localize "YOUR_FLAVOR.Config.Foundry.Sections.Global"}}</strong>
                            <small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.GlobalDescription"}}</small>
                        </span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="yf-foundry-overview-group">
                <h4><i class="fas fa-layer-group" aria-hidden="true"></i>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.AreasTitle"}}</h4>
                <div class="yf-foundry-overview-area-grid">
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="navigation">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-map-location-dot"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Foundry.Components.navigation"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.NavigationDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="controls">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-crosshairs"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Config.Foundry.Sections.Controls"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.ControlsDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="hotbar">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-keyboard"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Config.Foundry.Sections.Hotbar"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.HotbarDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="sidebar">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-columns"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Foundry.Components.sidebar"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.SidebarDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="chatLog">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-comments"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Config.Diagnostics.SelectorAreas.ChatLog"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.ChatLogDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="players">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-user-group"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Foundry.Components.players"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.PlayersDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="windows">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="far fa-window-maximize"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Config.Diagnostics.SelectorAreas.Windows"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.WindowsDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yf-foundry-destination-card" data-action="switchFoundrySection" data-section="pause">
                        <span class="yf-foundry-destination-icon" aria-hidden="true"><i class="fas fa-circle-pause"></i></span>
                        <span class="yf-foundry-destination-copy"><strong>{{localize "YOUR_FLAVOR.Config.Foundry.Sections.Pause"}}</strong><small>{{localize "YOUR_FLAVOR.Config.Foundry.OverviewHub.PauseDescription"}}</small></span>
                        <i class="fas fa-chevron-right yf-foundry-destination-arrow" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </section>
    </div>
    {{/if}}

    {{#if (eq activeFoundrySection "global")}}
    <div class="yf-foundry-global">
    <section class="yf-section yf-foundry-global-section yf-foundry-theme-presets">
        <div class="yf-foundry-global-section-heading">
            <span class="yf-foundry-global-section-number" aria-hidden="true">01</span>
            <div>
                <h3>{{localize "YOUR_FLAVOR.Config.Foundry.PresetsSection"}}</h3>
                <p>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.PresetHint"}}</p>
            </div>
            <span class="yf-foundry-theme-count">
                <strong>{{foundryThemeCarousel.total}}</strong>
                {{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.ThemeCount"}}
            </span>
        </div>

        <div class="yf-foundry-theme-roles" aria-label="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.PaletteLegend'}}">
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.PaletteLegend"}}:</span>
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.RoleSurface"}}</span>
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.RolePanel"}}</span>
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.RoleText"}}</span>
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.RoleAccent"}}</span>
            <span>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.RoleState"}}</span>
        </div>

        <div class="yf-foundry-theme-carousel">
            <button type="button" class="yf-foundry-theme-arrow" data-action="previousFoundryThemePage" title="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreviousPage'}}" aria-label="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreviousPage'}}" {{#unless foundryThemeCarousel.canGoPrevious}}disabled{{/unless}}>
                <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </button>

            <div class="yf-foundry-theme-grid" aria-live="polite">
            {{#each themePresets}}
            <button type="button" class="yf-foundry-theme-card {{#if this.isSelected}}is-selected{{/if}}" data-action="applyThemePreset" data-preset="{{this.id}}" title="{{this.description}}" aria-label="{{this.label}}" aria-pressed="{{#if this.isSelected}}true{{else}}false{{/if}}" style="{{this.cardStyle}}">
                <span class="yf-foundry-theme-vignette" aria-hidden="true">
                    <span class="yf-foundry-theme-vignette-header"></span>
                    <span class="yf-foundry-theme-vignette-rail">
                        <span></span><span></span><span></span>
                    </span>
                    <span class="yf-foundry-theme-vignette-panel">
                        <span></span><span class="is-active"></span><span></span>
                    </span>
                </span>
                <span class="yf-foundry-theme-card-copy">
                    <strong>{{this.label}}</strong>
                    <small>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.FoundryCompanion"}}</small>
                </span>
                <span class="yf-foundry-theme-palette" aria-hidden="true">
                    {{#each this.palette}}<span style="background: {{this}}"></span>{{/each}}
                </span>
                {{#if this.isSelected}}
                <span class="yf-foundry-theme-selected">{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.Selected"}}</span>
                {{/if}}
            </button>
            {{/each}}
            </div>

            <button type="button" class="yf-foundry-theme-arrow" data-action="nextFoundryThemePage" title="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.NextPage'}}" aria-label="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.NextPage'}}" {{#unless foundryThemeCarousel.canGoNext}}disabled{{/unless}}>
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>

        <div class="yf-foundry-preset-options">
            <div class="yf-foundry-theme-pagination">
                <span>{{foundryThemeCarousel.first}}-{{foundryThemeCarousel.last}} / {{foundryThemeCarousel.total}}</span>
                <div role="group" aria-label="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.PageNavigation'}}">
                    {{#each foundryThemeCarousel.pages}}
                    <button type="button" class="{{#if this.isActive}}is-active{{/if}}" data-action="selectFoundryThemePage" data-page="{{this.index}}" title="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.Page'}} {{this.pageNumber}}" aria-label="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.Page'}} {{this.pageNumber}}" aria-pressed="{{#if this.isActive}}true{{else}}false{{/if}}"></button>
                    {{/each}}
                </div>
            </div>
            <div class="yf-foundry-preserve-stack">
                <label class="yf-foundry-preserve-icons" title="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreserveCustomIconsHint'}}">
                    <input type="checkbox" name="foundry.preserveCustomIconColors" {{#if foundryConfig.preserveCustomIconColors}}checked{{/if}}>
                    <span>
                        <strong>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreserveCustomIcons"}}</strong>
                        <small>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreserveCustomIconsHint"}}</small>
                    </span>
                </label>
                <label class="yf-foundry-preserve-icons" title="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreserveCustomFontsHint'}}">
                    <input type="checkbox" name="foundry.preserveCustomFonts" {{#if foundryConfig.preserveCustomFonts}}checked{{/if}}>
                    <span>
                        <strong>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreserveCustomFonts"}}</strong>
                        <small>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.PreserveCustomFontsHint"}}</small>
                    </span>
                </label>
            </div>
        </div>
    </section>

    <section class="yf-section yf-foundry-global-section yf-foundry-customize-theme">
        <div class="yf-foundry-customize-compact-heading">
            <span class="yf-foundry-customize-tag">{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.CustomizeTitle"}}</span>
            <small>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.CustomizeHint"}}</small>
        </div>
        <div class="yf-foundry-customize-fonts">
            <div class="yf-foundry-customize-field">
                <label for="yf-foundry-interface-font">{{localize "YOUR_FLAVOR.Config.Foundry.InterfaceFont"}}</label>
                <select id="yf-foundry-interface-font" name="foundry.theme.interfaceFont" class="yf-select yf-refined-select" data-yf-font-preview="true" title="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.FontManualHint'}}">
                    {{#each foundryFonts}}
                    <option value="{{this.family}}" {{#if (eq this.family ../foundryConfig.theme.interfaceFont)}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="yf-foundry-customize-field">
                <label for="yf-foundry-window-font">{{localize "YOUR_FLAVOR.Config.Foundry.WindowFont"}}</label>
                <select id="yf-foundry-window-font" name="foundry.theme.windowFont" class="yf-select yf-refined-select" data-yf-font-preview="true" title="{{localize 'YOUR_FLAVOR.Config.Foundry.GlobalDesign.FontManualHint'}}">
                    {{#each foundryFonts}}
                    <option value="{{this.family}}" {{#if (eq this.family ../foundryConfig.theme.windowFont)}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        <div class="yf-foundry-customize-colors">
            <div class="yf-foundry-customize-colors-heading">
                <strong>{{localize "YOUR_FLAVOR.Config.Foundry.ThemeColors"}}</strong>
                <small>{{localize "YOUR_FLAVOR.Config.Foundry.GlobalDesign.ColorHint"}}</small>
            </div>
            <div class="yf-color-grid">
                {{#each foundryThemeFields}}
                <label class="yf-color-chip yf-nullable-color-chip {{#if this.isStock}}is-stock{{/if}}">
                    <span>{{this.label}}</span>
                    <input type="color" name="{{this.name}}" class="yf-color-swatch yf-nullable-color {{#if this.isStock}}is-stock{{/if}}" value="{{this.value}}" data-nullable-color="true" data-stock="{{#if this.isStock}}true{{else}}false{{/if}}" data-stock-label="{{this.stockLabel}}" data-clear-title="{{this.clearTitle}}">
                    {{#if this.isStock}}<small>{{this.stockLabel}}</small>{{/if}}
                </label>
                {{/each}}
            </div>
        </div>
    </section>
    </div>
    {{/if}}

    {{#if foundryActiveAreaPage}}
    {{#if foundryActiveAreaPage.isNavigation}}
    <div class="yf-foundry-scene-navigation-workbench">
        {{> "modules/your-flavor/templates/parts/flavor-preview-panel.hbs"}}
        <div class="yf-foundry-scene-navigation-controls">
    {{/if}}
    {{#if foundryActiveAreaPage.isControls}}
    <div class="yf-foundry-token-controls-workbench">
        {{> "modules/your-flavor/templates/parts/flavor-preview-panel.hbs"}}
        <div class="yf-foundry-token-controls-controls">
    {{/if}}
    {{#if foundryActiveAreaPage.isHotbar}}
    <div class="yf-foundry-macro-bar-workbench">
        {{> "modules/your-flavor/templates/parts/flavor-preview-panel.hbs"}}
        <div class="yf-foundry-macro-bar-controls">
    {{/if}}
    {{#if foundryActiveAreaPage.isSidebar}}
    <div class="yf-foundry-sidebar-workbench">
        {{> "modules/your-flavor/templates/parts/flavor-foundry-sidebar-preview.hbs"}}
        <div class="yf-foundry-sidebar-controls" data-yf-sidebar-settings-scroll>
    {{/if}}
    {{#if foundryActiveAreaPage.isChatLog}}
    <div class="yf-foundry-chat-log-workbench">
        {{> "modules/your-flavor/templates/parts/flavor-foundry-chat-log-preview.hbs"}}
        <div class="yf-foundry-chat-log-controls" data-yf-chat-log-settings-scroll>
    {{/if}}
    {{#if foundryActiveAreaPage.isPlayers}}
    <div class="yf-foundry-player-list-workbench">
        {{> "modules/your-flavor/templates/parts/flavor-foundry-player-list-preview.hbs"}}
        <div class="yf-foundry-player-list-controls" data-yf-player-list-settings-scroll>
    {{/if}}
    {{#if foundryActiveAreaPage.isWindows}}
    <div class="yf-foundry-windows-workbench">
        {{> "modules/your-flavor/templates/parts/flavor-foundry-windows-preview.hbs"}}
        <div class="yf-foundry-windows-controls" data-yf-windows-settings-scroll>
    {{/if}}
    {{#if foundryActiveAreaPage.isPause}}
    <div class="yf-foundry-pause-workbench">
        <div class="yf-foundry-pause-preview-stack">
            {{> "modules/your-flavor/templates/parts/flavor-foundry-pause-preview.hbs"}}
            {{#if foundryActiveAreaPage.hasIconEntries}}
            <section class="yf-section yf-foundry-area-icons yf-foundry-pause-area-icons">
                <div class="yf-section-header">
                    <i class="fas fa-icons"></i>
                    <h3>{{localize "YOUR_FLAVOR.Config.Foundry.AreaIconsSection"}}</h3>
                </div>
                <p class="yf-section-hint">{{localize "YOUR_FLAVOR.Config.Foundry.AreaIconsHint"}}</p>
                <div class="yf-foundry-icon-target-list">
                    {{#each foundryActiveAreaPage.iconEntries}}
                    <span class="yf-foundry-icon-target" data-area-icon-id="{{this.id}}" data-area-icon-fallback="{{#if this.usesFallbackGlyph}}true{{else}}false{{/if}}">
                        <i class="{{this.displayIconClass}}" aria-hidden="true" data-area-icon-glyph></i>
                        <span>{{this.label}}</span>
                    </span>
                    {{/each}}
                </div>
                <div class="yf-foundry-layout-actions">
                    <button type="button" class="yf-btn yf-btn-secondary" data-action="switchTab" data-tab="icons">
                        <i class="fas fa-icons"></i>
                        <span class="yf-btn-label">{{localize "YOUR_FLAVOR.Config.Foundry.OpenIconsTab"}}</span>
                    </button>
                </div>
            </section>
            {{/if}}
        </div>
        <div class="yf-foundry-pause-controls" data-yf-pause-settings-scroll>
    {{/if}}
    <section class="yf-section yf-foundry-area-page {{#if foundryActiveAreaPage.isNavigation}}yf-foundry-scene-navigation-summary{{/if}} {{#if foundryActiveAreaPage.isControls}}yf-foundry-token-controls-summary{{/if}} {{#if foundryActiveAreaPage.isHotbar}}yf-foundry-macro-bar-summary{{/if}} {{#if foundryActiveAreaPage.isSidebar}}yf-foundry-sidebar-summary{{/if}} {{#if foundryActiveAreaPage.isChatLog}}yf-foundry-chat-log-summary{{/if}} {{#if foundryActiveAreaPage.isPlayers}}yf-foundry-player-list-summary{{/if}} {{#if foundryActiveAreaPage.isWindows}}yf-foundry-windows-summary{{/if}} {{#if foundryActiveAreaPage.isPause}}yf-foundry-pause-summary{{/if}}">
        <div class="yf-foundry-area-page-header">
            <div>
                <div class="yf-section-header">
                    <i class="{{foundryActiveAreaPage.icon}}"></i>
                    <h3>{{foundryActiveAreaPage.label}}</h3>
                </div>
                <p class="yf-section-hint">{{foundryActiveAreaPage.description}}</p>
            </div>
            <button type="button" class="yf-btn-ghost" data-action="exportConfig" data-area="{{foundryActiveAreaPage.areaId}}" title="{{foundryActiveAreaPage.exportTitle}}" aria-label="{{foundryActiveAreaPage.exportTitle}}">
                <i class="fas fa-file-export"></i>
            </button>
        </div>

        <div class="yf-foundry-area-control-grid">
